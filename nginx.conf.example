# picshare nginx site — drop into /etc/nginx/sites-available/picshare.conf
#
# Architecture: Nginx 直出原图，Go 仅处理 API + 缩略图 + 后台。
# - GET /photos/*  → 直接读原始图片，绕过 Go，零开销
# - 所有其他请求 → 反代到 Go :8080

server {
    listen 80;
    server_name gallery.example.com;
    # 上传走 Go 处理；此值须 >= Go 配置 max_upload_mb，否则大文件先被 Nginx 拒
    client_max_body_size 512m;
    proxy_request_buffering off;     # 流式转发，不落 Nginx 盘
    proxy_http_version 1.1;

    # 拒绝所有点开头的隐藏文件/目录（.hidden、.order、.git 等）
    location ~ /\. {
        deny all;
    }

    # 静态文件直出（关键优化：原图 0 拷贝发送），只放行图片扩展名
    location /photos/ {
        alias /var/lib/picshare/photos/;
        location ~* \.(jpe?g|png|webp|gif|bmp|tiff?)$ {
            expires 7d;
            access_log off;
            try_files $uri =404;
        }
        deny all;
    }

    # 缩略图缓存（可选：也可直接走 Go）
    location /thumbs/ {
        alias /var/lib/picshare/thumbs/;
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    # API + 后台 + 缩略图生成 + 前端 HTML
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
