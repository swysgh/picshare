[Unit]
Description=picshare - lightweight product image gallery
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/picshare --config /etc/picshare.json
Restart=on-failure
RestartSec=5
WorkingDirectory=/hhdisk/rich37/picshare

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/hhdisk/rich37/picshare/photos /hhdisk/rich37/picshare/thumbs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=picshare

[Install]
WantedBy=multi-user.target
